# Save this file as: .github/workflows/daily-post.yml in your repo.
#
# Before this works, add two repo secrets:
#   Settings > Secrets and variables > Actions > New repository secret
#     VIVALDI_ACCESS_TOKEN = your Mastodon app access token
#     VIVALDI_INSTANCE_URL = https://vivaldi.social   (or your instance)
#
# GitHub Actions cron uses UTC. The schedule below runs daily at 09:00 UTC
# (~2:30 PM IST) — change the "cron" line to shift the time.

name: Daily Vivaldi Social Post

on:
  schedule:
    - cron: "0 9 * * *"
  workflow_dispatch: {}  # lets you trigger it manually from the Actions tab

jobs:
  post:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install -r requirements.txt

      - run: python daily_poster.py
        env:
          VIVALDI_ACCESS_TOKEN: ${{ secrets.VIVALDI_ACCESS_TOKEN }}
          VIVALDI_INSTANCE_URL: ${{ secrets.VIVALDI_INSTANCE_URL }}

      # Commit the updated posted_links.json back so it doesn't repeat stories
      - run: |
          git config user.name "daily-poster-bot"
          git config user.email "actions@github.com"
          git add posted_links.json
          git diff --cached --quiet || git commit -m "Update posted links log"
          git push
